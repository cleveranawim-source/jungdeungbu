rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 공통 함수 ----------
    // 한 요청의 get()/exists() 한도(단일 문서 10, 배치 20)를 넘지 않도록 같은 문서만 되풀이해 본다
    // (같은 문서 조회는 한 번으로 계산된다).

    function isSignedIn() {
      return request.auth != null;
    }

    // 로그인 토큰의 이메일(소문자). invites 문서 ID와 비교한다.
    function myEmail() {
      return request.auth.token.email.lower();
    }

    function hasVerifiedEmail() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function inviteOf(email) {
      return get(/databases/$(database)/documents/invites/$(email));
    }

    function teacherPath() {
      return /databases/$(database)/documents/teachers/$(request.auth.uid);
    }

    function teacherDoc() {
      return get(teacherPath());
    }

    function isTeacher() {
      return isSignedIn() && exists(teacherPath());
    }

    function isAdmin() {
      return isTeacher() && teacherDoc().data.role == 'admin';
    }

    // 그 반 담당 교사 또는 관리자
    function teachesClass(classId) {
      return isAdmin() || (isTeacher() && classId in teacherDoc().data.classIds);
    }

    // src/lib/token.ts TOKEN_RE 와 같은 형식
    function isToken(s) {
      return s is string && s.matches('^[A-Za-z0-9_-]{22}$');
    }

    function isDateId(s) {
      return s is string && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function studentPath(token) {
      return /databases/$(database)/documents/students/$(token);
    }

    function studentOf(token) {
      return get(studentPath(token));
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ---------- teachers · invites ----------

    match /teachers/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      // 첫 로그인: 자기 uid 문서를 invites/{email} 그대로 복사해서만 만든다.
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && hasVerifiedEmail()
        && request.resource.data.keys().hasOnly(['email', 'name', 'role', 'classIds'])
        && request.resource.data.email == myEmail()
        && request.resource.data.name == inviteOf(myEmail()).data.name
        && request.resource.data.role == inviteOf(myEmail()).data.role
        && request.resource.data.classIds == inviteOf(myEmail()).data.classIds;
      allow update, delete: if isAdmin();
    }

    match /invites/{email} {
      allow get: if (hasVerifiedEmail() && myEmail() == email) || isAdmin();
      allow list, create, update, delete: if isAdmin();
    }

    // ---------- classes · students ----------

    match /classes/{classId} {
      allow get: if true;
      allow list: if isTeacher();
      allow create, update, delete: if isAdmin();
    }

    match /students/{token} {
      allow get: if true;
      allow list: if isTeacher();
      allow create, delete: if isAdmin();
      // 관리자는 무엇이든(재발급 시 active:false 포함). 반 교사는 출석 배치의 streak·lastPresent만.
      allow update: if isAdmin()
        || (teachesClass(resource.data.classId)
            && changedOnly(['streak', 'lastPresent'])
            && request.resource.data.streak is int
            && request.resource.data.streak >= 0
            && (request.resource.data.lastPresent == null || isDateId(request.resource.data.lastPresent)));
    }
  }
}
