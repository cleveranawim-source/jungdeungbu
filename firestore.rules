rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 공통 함수 ----------
    // 한 요청의 get()/exists() 한도(단일 문서 10, 배치 20)를 넘지 않도록 각 규칙은 같은 문서
    // (내 teachers 문서, 내 invites 문서, 내 studentSessions 문서, 대상 students 문서)만 되풀이해 본다.
    // 같은 문서 조회는 캐시되어 한 번으로 계산된다 — attendance.test.ts의 52주 재발급 배치 시험이 이를 지킨다.

    function isSignedIn() {
      return request.auth != null;
    }

    // 로그인 토큰의 이메일(소문자). invites 문서 ID와 비교한다.
    function myEmail() {
      return request.auth.token.email.lower();
    }

    function hasVerifiedEmail() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    // 호칭(목사님·전도사님 등): 없으면 화면에서 "선생님". 있으면 10자 이하 글자.
    function validTitle(d) {
      return !('title' in d) || (d.title is string && d.title.size() <= 10);
    }

    function inviteOf(email) {
      return get(/databases/$(database)/documents/invites/$(email));
    }

    function teacherPath() {
      return /databases/$(database)/documents/teachers/$(request.auth.uid);
    }

    function teacherDoc() {
      return get(teacherPath());
    }

    function isTeacher() {
      return isSignedIn() && exists(teacherPath());
    }

    function isAdmin() {
      return isTeacher() && teacherDoc().data.role == 'admin';
    }

    // 그 반 담당 교사 또는 관리자
    function teachesClass(classId) {
      return isAdmin() || (isTeacher() && classId in teacherDoc().data.classIds);
    }

    // src/lib/token.ts TOKEN_RE 와 같은 형식
    function isToken(s) {
      return s is string && s.matches('^[A-Za-z0-9_-]{22}$');
    }

    function isDateId(s) {
      return s is string && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function studentPath(token) {
      return /databases/$(database)/documents/students/$(token);
    }

    function studentOf(token) {
      return get(studentPath(token));
    }

    // 출석 문서: { date, present, by: 쓴 사람 uid, at: serverTimestamp() }.
    // 관리자는 재발급 때 원래 기록(by·at)을 그대로 복사할 수 있다.
    function validAttendance(date) {
      let d = request.resource.data;
      return isDateId(date)
        && d.keys().hasOnly(['date', 'present', 'by', 'at'])
        && d.date == date
        && d.present is bool
        && ((d.by == request.auth.uid && d.at == request.time)
            || (isAdmin() && d.by is string && d.at is timestamp));
    }

    // 학생 기기(익명 인증)의 세션: studentSessions/{uid} = { token }
    function sessionOf(uid) {
      return get(/databases/$(database)/documents/studentSessions/$(uid));
    }

    // 기도 제목: { authorUid, studentName, text, createdAt: serverTimestamp() } (+ extraKeys).
    // 공개 문서에 토큰을 넣지 않는다. 글쓴이는 익명 인증 UID이고, 그 UID의 세션이 가리키는
    // 활성 학생의 반·이름과 맞아야 한다. 조회: 세션 1 + 학생 1.
    function validPrayer(d, classId, extraKeys) {
      let student = studentOf(sessionOf(request.auth.uid).data.token);
      return request.auth != null
        && d.authorUid == request.auth.uid
        && student.data.active == true
        && student.data.classId == classId
        && d.studentName == student.data.name
        && d.text is string && d.text.size() >= 1 && d.text.size() <= 500
        && d.createdAt == request.time
        && d.keys().hasOnly(['authorUid', 'studentName', 'text', 'createdAt'].concat(extraKeys));
    }

    // 활성 학생 세션: 학생 링크를 연 기기(익명 로그인)이고 그 링크의 학생이 활성이어야 한다.
    // 세션 문서가 없으면 exists() 가 false 라 그냥 거절, 토큰이 가리키는 학생 문서가 없으면
    // 평가 오류로 거절된다(어느 쪽이든 닫힌 채로 실패).
    // 조회: 세션 1 + 학생 1.
    function isMember() {
      return request.auth != null
        && exists(/databases/$(database)/documents/studentSessions/$(request.auth.uid))
        && studentOf(sessionOf(request.auth.uid).data.token).data.active == true;
    }

    // 주보의 출석 요약: null 또는 { sunday, classes, students, teachers } 안의 키만 든 맵.
    function validAttendanceSummary(a) {
      return a == null
        || (a is map && a.keys().hasOnly(['sunday', 'classes', 'students', 'teachers']));
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ---------- teachers · invites ----------

    match /teachers/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      // 첫 로그인: 자기 uid 문서를 invites/{email} 그대로 복사해서만 만든다.
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && hasVerifiedEmail()
        && request.resource.data.keys().hasOnly(['email', 'name', 'role', 'classIds', 'title'])
        && request.resource.data.email == myEmail()
        && request.resource.data.name == inviteOf(myEmail()).data.name
        && request.resource.data.get('title', '') == inviteOf(myEmail()).data.get('title', '')
        && request.resource.data.role == inviteOf(myEmail()).data.role
        && request.resource.data.classIds == inviteOf(myEmail()).data.classIds;
      allow update, delete: if isAdmin();
    }

    match /invites/{email} {
      allow get: if (hasVerifiedEmail() && myEmail() == email) || isAdmin();
      allow list, delete: if isAdmin();
      allow create, update: if isAdmin()
        && email == email.lower()
        && request.resource.data.role in ['admin', 'teacher']
        && validTitle(request.resource.data);
    }

    // ---------- classes · students ----------

    match /classes/{classId} {
      allow get: if true;
      allow list: if isTeacher();
      allow create, update, delete: if isAdmin();

      // ---------- 우리 반 기도 (반 ID를 아는 사람에게 공개; 문서에 비밀 값 없음) ----------
      // 수정 규칙 없음. 삭제는 교사 또는 글쓴이 본인(같은 익명 UID).
      match /prayers/{id} {
        allow read: if true;
        allow create: if validPrayer(request.resource.data, classId, []);
        allow delete: if isTeacher()
          || (request.auth != null && request.auth.uid == resource.data.authorUid);
      }
    }

    // 토큰을 아는 사람은 활성 학생만 읽는다(재발급된 옛 링크는 즉시 죽는다). 교사는 모두.
    match /students/{token} {
      allow get: if isTeacher() || resource.data.active == true;
      allow list: if isTeacher();
      allow create: if isAdmin() && isToken(token);
      allow delete: if isAdmin();
      // 관리자는 무엇이든(재발급 시 active:false 포함). 반 교사는 출석 배치의 streak·lastPresent만.
      allow update: if isAdmin()
        || (teachesClass(resource.data.classId)
            && changedOnly(['streak', 'lastPresent'])
            && request.resource.data.streak is int
            && request.resource.data.streak >= 0
            && (request.resource.data.lastPresent == null || isDateId(request.resource.data.lastPresent)));

      // ---------- attendance ----------
      // 읽기: 교사, 또는 토큰(경로)을 알고 그 학생이 활성일 때. 쓰기: 그 반 교사 또는 관리자.
      // 관리자를 먼저 따지는 이유: 링크 재발급 배치에서는 새 학생 문서가 아직 없어서(get()은 배치 전 상태)
      // studentOf(token)를 볼 수 없다.
      match /attendance/{date} {
        allow read: if isTeacher() || studentOf(token).data.active == true;
        allow create, update: if (isAdmin() || teachesClass(studentOf(token).data.classId))
          && validAttendance(date);
        allow delete: if isAdmin() || teachesClass(studentOf(token).data.classId);
      }
    }

    // ---------- 콘텐츠: 주보 · 설교 · 광고 · 설정 ----------
    // 공개 콘텐츠라 누구나 읽고, 관리자만 쓴다. 주보·설교 문서 ID는 주일 날짜(yyyy-mm-dd).
    // 단, 임시저장 주보(published:false)는 교사만 읽는다. 목록 질의는 where('published','==',true)를
    // 걸어야 통과한다(규칙은 질의가 돌려줄 수 있는 모든 문서에 대해 따진다). 없는 문서 get은 빈 결과.

    match /bulletins/{date} {
      allow get: if resource == null || resource.data.published == true || isTeacher();
      allow list: if isTeacher() || resource.data.published == true;
      // 공개 문서라 허용 칸만 둔다. 이름·전화번호가 든 칸(newFriends·contacts 등)은 잠긴 문서에만 둔다.
      // 출석(attendance)은 없거나 null 이거나 정해진 키만 든 맵. 반 줄(classes)에는 이름·인원만 둔다 —
      // 반 ID는 그 반 기도 제목(classes/{id}/prayers)을 여는 열쇠라 공개 문서에 실리면 안 된다.
      // 규칙은 목록(classes)의 원소를 하나하나 볼 수 없어서, 원소의 모양은 앱(saveBulletin)이 지킨다.
      allow create, update: if isAdmin() && isDateId(date)
        && request.resource.data.keys().hasOnly(['date', 'order', 'hymns', 'scripture', 'sermonTitle',
             'published', 'updatedBy', 'updatedAt', 'issue', 'leader', 'opening', 'nextServers', 'attendance'])
        && validAttendanceSummary(request.resource.data.get('attendance', null));
      allow delete: if isAdmin() && isDateId(date);

      // 이름이 들어가는 정보는 여기(잠긴 문서)에만 둔다. 선생님 또는 활성 학생 세션만 get,
      // 학생은 공개된(published) 주보의 것만. list 없음.
      match /members/{id} {
        allow get: if isTeacher()
          || (isMember() && get(/databases/$(database)/documents/bulletins/$(date)).data.published == true);
        allow create, update: if isAdmin() && isDateId(date) && id == 'main'
          && request.resource.data.keys().hasOnly(['newFriends', 'birthdays']);
        allow delete: if isAdmin() && isDateId(date) && id == 'main';
      }
    }

    // 주보 초안: 관리자만. 새 친구·생일 이름이 들어 있으므로 교사·학생·로그인 없는 사람은 읽지 못한다.
    // 게시본(bulletins)과 따로 두는 이유: 초안을 저장해도 학생이 보는 주보가 내려가지 않게.
    // list 없음 — 초안은 날짜를 알고 get 으로만 연다.
    match /bulletinDrafts/{date} {
      allow get: if isAdmin();
      allow create, update: if isAdmin() && isDateId(date)
        && request.resource.data.keys().hasOnly(['date', 'bulletin', 'members', 'updatedBy', 'updatedAt'])
        && request.resource.data.date == date;
      allow delete: if isAdmin();
    }

    // 섬기는 사람·연락처(개인 번호): 선생님 또는 활성 학생 세션만 get. list 없음.
    match /memberInfo/{id} {
      allow get: if isTeacher() || isMember();
      allow create, update: if isAdmin() && id == 'main'
        && request.resource.data.keys().hasOnly(['servants', 'contacts']);
      allow delete: if isAdmin() && id == 'main';
    }

    match /sermons/{date} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && isDateId(date);
    }

    match /announcements/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /settings/{id} {
      allow read: if true;
      // settings/info 는 공개 문서: 연락처·명단 칸을 넣지 못하게 허용 칸만 둔다. 다른 문서는 그대로.
      allow create, update: if isAdmin()
        && (id != 'info'
            || request.resource.data.keys().hasOnly(['motto', 'etiquette', 'place', 'churchPhone']));
      allow delete: if isAdmin();
    }

    // ---------- 학생 세션 ----------
    // 학생 링크를 연 기기가 익명 로그인 뒤 자기 UID에 토큰을 묶는다(다른 링크를 열면 덮어씀).
    match /studentSessions/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['token'])
        && isToken(request.resource.data.token)
        && studentOf(request.resource.data.token).data.active == true;
    }

    // ---------- 선생님만 보는 기도 ----------
    match /prayers/{id} {
      allow read: if isTeacher();
      allow create: if request.resource.data.classId is string
        && validPrayer(request.resource.data, request.resource.data.classId, ['classId']);
      allow delete: if isTeacher();
    }

    // 교사 출석 화면: collectionGroup('attendance') where date == 주일
    match /{path=**}/attendance/{date} {
      allow read: if isTeacher();
    }
  }
}
